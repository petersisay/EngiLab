# ==============================================================================
# EngiLab Backend Environment Template
# Academic Laboratory Management Platform (ASTU - ECE & EPCE)
# Copy this template to .env and provide your local/deployment values.
# NEVER commit the active .env file to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION SETTINGS (Required for baseline)
# ------------------------------------------------------------------------------
# Runtime environment: development | production | test
NODE_ENV=development

# Port on which the Express HTTP server listens
PORT=5000

# ------------------------------------------------------------------------------
# 2. DATABASE SETTINGS (Required for baseline)
# ------------------------------------------------------------------------------
# MongoDB connection URI (Atlas connection string or local MongoDB instance)
# Example: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/engilab?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/engilab?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & TOKENS (Required for auth module)
# ------------------------------------------------------------------------------
# Secret keys for signing JSON Web Tokens (use secure, random strings >= 32 characters in production)
JWT_ACCESS_SECRET=your_jwt_access_secret_key_minimum_32_characters_long
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_minimum_32_characters_long

# Expiration lifetimes for tokens
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# 4. FRONTEND & CORS (Required for client integration)
# ------------------------------------------------------------------------------
# Origin URL of the frontend client allowed to make cross-origin requests
CLIENT_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# 5. INSTITUTIONAL EMAIL CONFIGURATION (Configurable domain check)
# ------------------------------------------------------------------------------
# Comma-separated list of allowed institutional email domains for registration
# Example: astu.edu.et or astu.edu.et,engilab.local
ASTU_ALLOWED_EMAIL_DOMAINS=astu.edu.et

# ------------------------------------------------------------------------------
# 6. SMTP / EMAIL SERVICE (Reserved for future password reset & notifications)
# ------------------------------------------------------------------------------
# SMTP credentials for sending automated transactional emails
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username_placeholder
SMTP_PASS=your_smtp_password_placeholder
EMAIL_FROM="EngiLab Platform <noreply@astu.edu.et>"

# ------------------------------------------------------------------------------
# 7. CLOUDINARY FILE STORAGE (Reserved for future lab report submission phase)
# ------------------------------------------------------------------------------
# Cloudinary account configuration for storing lab report attachments and PDFs
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name_placeholder
CLOUDINARY_API_KEY=your_cloudinary_api_key_placeholder
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_placeholder
